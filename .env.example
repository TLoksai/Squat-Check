# Copy this file to .env and fill in your own values. Never commit .env.
# The AI coach (feedback text) needs ONE of these keys. Without a key the app
# still works and shows rulebook tips, clearly labelled.

# Google Gemini (https://aistudio.google.com -> API keys)
GEMINI_API_KEY=
# Optional: pin a model, e.g. gemini-2.5-flash (default: newest stable "flash" model your key can use)
# GEMINI_MODEL=

# Anthropic Claude (https://console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Optional: force a coach when both keys are set: gemini | claude | rulebook
# COACH_PROVIDER=
